DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/rr

# Comma separated. Callers of the REST API send one as a bearer token.
API_KEYS=local-api-key
SUPPORT_KEY=local-support-key

# Local queues. On AWS the stack sets EVENT_BUS_NAME and the queues come from CDK.
SQS_ENDPOINT=http://127.0.0.1:59324
LOCAL_QUEUES=calendar-sync,email,webhooks

# Each of these is off while it is empty.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ELASTIC_URL=
ELASTIC_API_KEY=
MAIL_FROM=
CALDAV_USER=
CALDAV_PASSWORD=
